#!/bin/bash

# fig-status — Show Figma CLI connection status

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# CDP port — matches the CLI's --port / FIGMA_PORT support
CDP_PORT="${FIGMA_PORT:-9222}"

get_daemon_token() {
    local token_file="$HOME/.figma-ds-cli/.daemon-token"
    if [ -f "$token_file" ]; then
        cat "$token_file" 2>/dev/null
    fi
}

get_repo_path() {
    local config_file="$HOME/.figma-cli/config.json"
    if [ -f "$config_file" ]; then
        node -e 'try { process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).repoPath || "") } catch {}' "$config_file" 2>/dev/null
    fi
}

# Print a box row: label (9 chars) + icon (colored) + value (plain), padded to BOX_W
# Usage: box_row "Label   " "✓" "$GREEN" "some value"
BOX_W=44
box_row() {
    local label="$1"    # fixed-width label
    local icon="$2"     # single visible char (✓ / ✗ / ○)
    local color="$3"    # color for icon
    local value="$4"    # plain text value
    local inner="  ${label}${icon}  ${value}"
    local visible_len=$(( ${#label} + 1 + 2 + ${#value} + 2 ))
    local pad=$(( BOX_W - visible_len ))
    [ $pad -lt 0 ] && pad=0
    printf "  \033[2m│\033[0m  %s${color}%s\033[0m  %s%${pad}s\033[2m│\033[0m\n" \
        "$label" "$icon" "$value" ""
}

REPO_PATH=$(get_repo_path)
CLI=""
if [ -n "$REPO_PATH" ] && [ -f "$REPO_PATH/src/index.js" ]; then
    CLI="$REPO_PATH/src/index.js"
fi

echo ""
echo -e "  ${BOLD}fig-status${NC}"
echo ""

# ── Figma process ──
if pgrep -x "Figma" > /dev/null 2>&1; then
    FIGMA_ICON="✓"; FIGMA_COLOR="$GREEN"; FIGMA_VAL="running"
else
    FIGMA_ICON="○"; FIGMA_COLOR="$YELLOW"; FIGMA_VAL="not running"
fi

# ── Daemon: one /health read; the Link and File rows derive from it ──
# The daemon knows its transport (mode pipe/safe/yolo/browser, and whether the link is up).
# Probing port 9222 here showed "✗ not reachable" beside a green daemon in Pipe Mode, which
# has no port by design.
DAEMON_TOKEN=$(get_daemon_token)
H_STATUS=""; H_MODE=""; H_CDP=""; H_PIPE=""; H_PLUGIN=""; H_FILE=""
if [ -n "$DAEMON_TOKEN" ]; then
    DAEMON_HEALTH=$(curl -s --max-time 3 -H "X-Daemon-Token: $DAEMON_TOKEN" http://localhost:${DAEMON_PORT:-3456}/health 2>/dev/null)
    if [ -n "$DAEMON_HEALTH" ]; then
        # Unit separator, not tab: `read` collapses runs of whitespace IFS, so an empty field
        # (plugin: null in Pipe Mode) shifted the file name into the wrong variable.
        IFS=$'\x1f' read -r H_STATUS H_MODE H_CDP H_PIPE H_PLUGIN H_FILE < <(echo "$DAEMON_HEALTH" | node -e '
let r = ""; process.stdin.on("data", d => r += d).on("end", () => {
  let d = {}; try { d = JSON.parse(r) } catch {}
  const file = String(d.file || "").replace(" – Figma", "").replace(" - Figma", "").replace(/[\x1f\n]/g, " ");
  process.stdout.write([d.status || "", d.mode || "", d.cdp ? "1" : "", d.pipe ? "1" : "", d.plugin ? "1" : "", file].join("\x1f"));
})' 2>/dev/null)
    fi
fi

DAEMON_ICON="○"; DAEMON_COLOR="$YELLOW"; DAEMON_VAL="not running"
if [ "$H_STATUS" = "ok" ] || [ "$H_STATUS" = "disconnected" ]; then
    DAEMON_ICON="✓"; DAEMON_COLOR="$GREEN"; DAEMON_VAL="port ${DAEMON_PORT:-3456} (${H_MODE:-unknown})"
fi

# ── Link: how the daemon reaches Figma ──
if [ -n "$H_MODE" ]; then
    case "$H_MODE" in
        pipe)
            if [ -n "$H_PIPE" ] && [ -n "$H_CDP" ]; then LINK_ICON="✓"; LINK_COLOR="$GREEN"; LINK_VAL="pipe (no port)"
            else LINK_ICON="○"; LINK_COLOR="$YELLOW"; LINK_VAL="pipe — waiting for the document"; fi ;;
        safe)
            if [ -n "$H_PLUGIN" ]; then LINK_ICON="✓"; LINK_COLOR="$GREEN"; LINK_VAL="plugin"
            else LINK_ICON="○"; LINK_COLOR="$YELLOW"; LINK_VAL="waiting for the FigCli plugin"; fi ;;
        *)
            if [ -n "$H_CDP" ]; then LINK_ICON="✓"; LINK_COLOR="$GREEN"; LINK_VAL="port ${CDP_PORT}"
            elif [ -n "$H_PLUGIN" ]; then LINK_ICON="✓"; LINK_COLOR="$GREEN"; LINK_VAL="plugin"
            else LINK_ICON="✗"; LINK_COLOR="$RED"; LINK_VAL="port ${CDP_PORT} not reachable"; fi ;;
    esac
# No daemon: the port is the only thing left to ask.
elif curl -s --max-time 3 -o /dev/null -w "%{http_code}" http://localhost:${CDP_PORT}/json 2>/dev/null | grep -q "200"; then
    LINK_ICON="✓"; LINK_COLOR="$GREEN"; LINK_VAL="port ${CDP_PORT} (no daemon)"
else
    LINK_ICON="✗"; LINK_COLOR="$RED"; LINK_VAL="not reachable"
fi

# ── Active file: from /health; the `files` command only when the daemon has no name ──
FILE_ICON=" "; FILE_COLOR="$NC"; FILE_VAL="—"
if [ -n "$H_FILE" ]; then
    FILE_VAL="$H_FILE"
elif [ -n "$CLI" ] && [ -n "$DAEMON_TOKEN" ]; then
    FILES_JSON=$(node "$CLI" files 2>/dev/null)
    if [ -n "$FILES_JSON" ] && ! echo "$FILES_JSON" | grep -q '"error"'; then
        ACTIVE=$(echo "$FILES_JSON" | node -e '
let r = ""; process.stdin.on("data", d => r += d).on("end", () => {
  let files = []; try { files = JSON.parse(r) } catch {}
  if (files.length) process.stdout.write((files[0].title || "Untitled").replace(" – Figma", "").replace(" - Figma", ""));
});
' 2>/dev/null)
        if [ -n "$ACTIVE" ]; then
            FILE_ICON=" "; FILE_COLOR="$NC"; FILE_VAL="$ACTIVE"
        fi
    fi
fi

SEP=$(printf '─%.0s' {1..44})
echo -e "  ${DIM}┌${SEP}┐${NC}"
printf "  \033[2m│\033[0m  \033[1mStatus\033[0m%36s\033[2m│\033[0m\n" ""
echo -e "  ${DIM}├${SEP}┤${NC}"
box_row "Figma   " "$FIGMA_ICON"  "$FIGMA_COLOR"  "$FIGMA_VAL"
box_row "Link    " "$LINK_ICON"   "$LINK_COLOR"   "$LINK_VAL"
box_row "Daemon  " "$DAEMON_ICON" "$DAEMON_COLOR" "$DAEMON_VAL"
box_row "File    " "$FILE_ICON"   "$FILE_COLOR"   "$FILE_VAL"
echo -e "  ${DIM}└${SEP}┘${NC}"
echo ""
