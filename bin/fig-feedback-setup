#!/bin/bash

# fig-feedback-setup — install the machine-side half of the panel setup.
#
# The CLI half travels with the repo: FEEDBACK.md, the SessionStart hook in .claude/settings.json,
# and the /feedback-triage skill all work right after a clone. The machine half lives in ~/.claude,
# which is not version controlled, so on a second machine figma-claude would never learn that
# FEEDBACK.md exists — and would hit a permission prompt if it tried.
#
# Step 6 is not about feedback at all: it registers the Framelink MCP server and the rule that
# says which of the two tools answers which question. The name is now narrower than the job;
# renaming it would break what is written in CLAUDE.md and in muscle memory, so it stays.
#
# macOS only where it touches the keychain (step 6) — as is step 5, which looks in /Applications.
#
# Idempotent: running it twice changes nothing.

set -u

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# The checkout this script sits in — never a hardcoded path. The whole point is that the repo may
# live somewhere else, under a different user name, on the other machine.
REPO="$(cd "$(dirname "$0")/.." && pwd)"
FEEDBACK="$REPO/FEEDBACK.md"

CLAUDE_MD="$HOME/.claude/CLAUDE.md"
SETTINGS="$HOME/.claude/settings.json"
PRECOMPACT="$HOME/.claude/skills/pre-compact/SKILL.md"
APP_ASAR="/Applications/FigmaClaude.app/Contents/Resources/app.asar"

CLAUDE_MD_MARKER="## figma-cli Feedback"
# The sentence that was missing in the first version of the rule. Its own marker, because an
# install from back then has the section but not the sentence — and a panel session that files
# its findings in a project's LEARNINGS.md instead is exactly what happened without it.
BOTH_TARGETS_MARKER="A project's own LEARNINGS.md does not replace it"
SWEEP_MARKER="Sweep for CLI feedback"

# Step 6. The MCP server keeps Framelink's name so an existing per-project entry is recognised
# rather than duplicated under a second name.
MCP_NAME="Framelink_Figma_MCP"
KEYCHAIN_ACCOUNT="figma-api-key"
# Same keychain service `src/credentials.js` uses, so the key has one home rather than two.
KEYCHAIN_SERVICE="figma-cli"
TOOLS_MARKER="## Figma lesen: Framelink oder figma-cli"

ok()   { printf "  ${GREEN}✓${NC}  %s\n" "$1"; }
skip() { printf "  ${DIM}○${NC}  %s\n" "$1"; }
warn() { printf "  ${YELLOW}!${NC}  %s\n" "$1"; }
fail() { printf "  ${RED}✗${NC}  %s\n" "$1"; }

printf "\n${BOLD}Feedback loop — panel half${NC}\n"
printf "  ${DIM}repo: %s${NC}\n\n" "$REPO"

if [ ! -f "$FEEDBACK" ]; then
    fail "No FEEDBACK.md in $REPO — wrong checkout, or the branch predates the feedback loop."
    exit 1
fi

# --- 1. The rule, so a panel session knows the inbox exists ------------------------------------

mkdir -p "$HOME/.claude"

if [ -f "$CLAUDE_MD" ] && grep -qF "$CLAUDE_MD_MARKER" "$CLAUDE_MD"; then
    if grep -qF "$BOTH_TARGETS_MARKER" "$CLAUDE_MD"; then
        skip "~/.claude/CLAUDE.md already carries the rule"
    else
        # The section is there but predates the sentence about the competing target.
        cp "$CLAUDE_MD" "$CLAUDE_MD.bak"
        cat >> "$CLAUDE_MD" <<EOF

$BOTH_TARGETS_MARKER: a figma-cli friction goes to \`$FEEDBACK\` even when the same finding is
also worth a line where you are working. (Amends the \`$CLAUDE_MD_MARKER\` rule above.)
EOF
        ok "rule amended: LEARNINGS.md does not replace FEEDBACK.md"
        printf "     ${DIM}backup: %s${NC}\n" "$CLAUDE_MD.bak"
    fi
else
    [ -f "$CLAUDE_MD" ] && cp "$CLAUDE_MD" "$CLAUDE_MD.bak"
    # A blank line first only when the file exists and does not already end in one.
    if [ -s "$CLAUDE_MD" ] && [ -n "$(tail -c 2 "$CLAUDE_MD" | head -c 1)" ]; then
        printf "\n" >> "$CLAUDE_MD"
    fi
    cat >> "$CLAUDE_MD" <<EOF
$CLAUDE_MD_MARKER

When \`\$FIGMACLAUDE\` is set, this session runs in FigmaClaude.app. Anything figma-cli or the
panel got wrong — a command that failed, docs that lied, a workaround, a missing command —
goes into \`$FEEDBACK\` under \`## Open\`, in the same session it happened. That file carries
its own Format section; read it before writing the first entry. It is the only file in that
repo a panel session may write. Applies in every project.

A project's own LEARNINGS.md does not replace it: a figma-cli friction goes to \`$FEEDBACK\`
even when the same finding is also worth a line where you are working.
EOF
    ok "rule appended to ~/.claude/CLAUDE.md"
    [ -f "$CLAUDE_MD.bak" ] && printf "     ${DIM}backup: %s${NC}\n" "$CLAUDE_MD.bak"
fi

# Daniel's own rule: a CLAUDE.md stays under 200 lines.
LINES=$(wc -l < "$CLAUDE_MD" | tr -d ' ')
if [ "$LINES" -gt 200 ]; then
    warn "~/.claude/CLAUDE.md is now $LINES lines — over the 200-line rule, condense it"
else
    printf "     ${DIM}%s lines of 200${NC}\n" "$LINES"
fi

# --- 2. The permission, so writing an entry costs no prompt ------------------------------------

# node, not jq: the CLI needs Node ≥18 anyway, and jq is not reliably installed here.
node -e '
const fs = require("fs");
const [settings, feedback] = process.argv.slice(1);
const rule = "Edit(/" + feedback + ")";
let config = {};
let existed = false;
try {
  config = JSON.parse(fs.readFileSync(settings, "utf8"));
  existed = true;
} catch (error) {
  if (error.code !== "ENOENT") {
    // A settings.json that does not parse must not be overwritten — every setting in it would
    // be lost, and the file is the user\x27s, not ours.
    console.log("PARSE_ERROR " + error.message);
    process.exit(3);
  }
}
config.permissions = config.permissions || {};
config.permissions.allow = config.permissions.allow || [];
if (config.permissions.allow.includes(rule)) {
  console.log("PRESENT");
  process.exit(0);
}
if (existed) fs.copyFileSync(settings, settings + ".bak");
config.permissions.allow.unshift(rule);
fs.writeFileSync(settings, JSON.stringify(config, null, 2) + "\n");
console.log(existed ? "ADDED" : "CREATED");
' "$SETTINGS" "$FEEDBACK" > /tmp/fig-feedback-setup.$$ 2>&1
NODE_STATUS=$?
RESULT=$(cat /tmp/fig-feedback-setup.$$)
rm -f /tmp/fig-feedback-setup.$$

case "$RESULT" in
    PRESENT) skip "~/.claude/settings.json already allows writing FEEDBACK.md" ;;
    ADDED)   ok "permission added to ~/.claude/settings.json"
             printf "     ${DIM}backup: %s${NC}\n" "$SETTINGS.bak" ;;
    CREATED) ok "~/.claude/settings.json created with the permission" ;;
    PARSE_ERROR*)
             fail "~/.claude/settings.json does not parse — fix it, then run this again"
             printf "     ${DIM}%s${NC}\n" "${RESULT#PARSE_ERROR }"
             exit 1 ;;
    *)       fail "could not write the permission into ~/.claude/settings.json"
             printf "     ${DIM}node exited %s: %s${NC}\n" "$NODE_STATUS" "$RESULT"
             exit 1 ;;
esac

# --- 3. The in-the-moment trigger, so a long session does not lose its findings ----------------
#
# The sweep below only fires before a /compact. A panel session that runs all day without one
# files nothing — that is how seven frictions ended up reported by hand instead. This hook reminds
# once per session, right after a figma-cli call fails or warns.

HOOK="$REPO/bin/fig-feedback-hook"
DECIDER="$REPO/bin/fig-feedback-decide.mjs"

# Both halves: the shell gate and the node decision it pipes into. Without the second one the hook
# is a no-op — the version that decided in shell alone fired on `tail LEARNINGS.md`.
if [ ! -x "$HOOK" ] || [ ! -f "$DECIDER" ]; then
    warn "bin/fig-feedback-hook or bin/fig-feedback-decide.mjs missing — trigger skipped"
else
    node -e '
const fs = require("fs");
const [settings, hook] = process.argv.slice(1);
let config = {};
let existed = false;
try {
  config = JSON.parse(fs.readFileSync(settings, "utf8"));
  existed = true;
} catch (error) {
  if (error.code !== "ENOENT") { console.log("PARSE_ERROR " + error.message); process.exit(3); }
}
config.hooks = config.hooks || {};
const list = (config.hooks.PostToolUse = config.hooks.PostToolUse || []);
// One entry per matcher, and the command is matched by NAME: the repo may have moved since the
// last run, and a stale absolute path would leave the hook silently dead.
const mine = (h) => typeof h?.command === "string" && h.command.includes("fig-feedback-hook");
for (const group of list) {
  const hooks = group.hooks || [];
  const found = hooks.find(mine);
  if (!found) continue;
  if (found.command === hook) { console.log("PRESENT"); process.exit(0); }
  if (existed) fs.copyFileSync(settings, settings + ".bak");
  found.command = hook;
  fs.writeFileSync(settings, JSON.stringify(config, null, 2) + "\n");
  console.log("REPATHED");
  process.exit(0);
}
const bash = list.find((g) => g.matcher === "Bash");
const entry = { type: "command", command: hook, timeout: 5 };
if (bash) (bash.hooks = bash.hooks || []).push(entry);
else list.push({ matcher: "Bash", hooks: [entry] });
if (existed) fs.copyFileSync(settings, settings + ".bak");
fs.writeFileSync(settings, JSON.stringify(config, null, 2) + "\n");
console.log(existed ? "ADDED" : "CREATED");
' "$SETTINGS" "$HOOK" > /tmp/fig-feedback-hook.$$ 2>&1
    HOOK_STATUS=$?
    HOOK_RESULT=$(cat /tmp/fig-feedback-hook.$$)
    rm -f /tmp/fig-feedback-hook.$$

    case "$HOOK_RESULT" in
        PRESENT)  skip "PostToolUse hook already installed" ;;
        REPATHED) ok "PostToolUse hook re-pointed at this checkout" ;;
        ADDED)    ok "PostToolUse hook added to ~/.claude/settings.json" ;;
        CREATED)  ok "~/.claude/settings.json created with the hook" ;;
        PARSE_ERROR*)
                  fail "~/.claude/settings.json does not parse — fix it, then run this again"
                  exit 1 ;;
        *)        fail "could not write the hook into ~/.claude/settings.json"
                  printf "     ${DIM}node exited %s: %s${NC}\n" "$HOOK_STATUS" "$HOOK_RESULT"
                  exit 1 ;;
    esac
    printf "     ${DIM}reminds once per session, panel sessions only${NC}\n"
fi

# --- 4. The pre-compact sweep, if that skill is installed here ---------------------------------

if [ ! -f "$PRECOMPACT" ]; then
    skip "pre-compact skill not installed — sweep skipped"
elif grep -qF "$SWEEP_MARKER" "$PRECOMPACT"; then
    skip "pre-compact skill already carries the sweep"
else
    cp "$PRECOMPACT" "$PRECOMPACT.bak"
    cat >> "$PRECOMPACT" <<EOF

## Sweep for CLI feedback

Before compacting a FigmaClaude session (\`\$FIGMACLAUDE\` set), go through it and ask what was
figma-cli's or the panel's fault rather than the design's — a command that failed, docs that were
wrong, a workaround that was needed, a missing command. Anything that never made it into
\`$FEEDBACK\` in the moment goes there now, under \`## Open\`.
EOF
    ok "sweep appended to the pre-compact skill"
    printf "     ${DIM}backup: %s${NC}\n" "$PRECOMPACT.bak"
fi

# --- 5. Does the installed app actually set the marker the rule keys on? -----------------------

if [ ! -e "$APP_ASAR" ]; then
    skip "FigmaClaude.app not installed in /Applications"
elif grep -aq 'env.FIGMACLAUDE' "$APP_ASAR"; then
    ok "installed FigmaClaude.app sets FIGMACLAUDE"
else
    warn "installed FigmaClaude.app predates the FIGMACLAUDE marker — the rule will never fire"
    printf "     ${DIM}fix: cd %s/app && npm run install:app${NC}\n" "$REPO"
fi

# --- 6. Framelink MCP, so every session on this machine can read a file it did not build -------
#
# Framelink reads Figma over the REST API; figma-cli drives the live document. Neither replaces
# the other, and a session that has only one of them does the other one's job badly. The
# measurements behind the division of labour are in `figma-cli docs framelink`.

if ! command -v claude >/dev/null 2>&1; then
    skip "claude CLI not on PATH — cannot register an MCP server"
elif claude mcp list 2>/dev/null | grep -q "$MCP_NAME"; then
    skip "$MCP_NAME already registered"
else
    # The keychain is the source; ask only when it has nothing. `-w` prints the secret, so it is
    # never echoed and never passed through a file.
    KEY="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w 2>/dev/null || true)"
    # Nothing in the keychain, but the key is probably already here: the per-project entries in
    # ~/.claude.json carry it inline. Adopt it rather than asking — Figma shows a personal access
    # token exactly once, at creation, so "paste your token" means "make a new one" for anyone
    # who set this up months ago. Captured into a variable, never printed.
    if [ -z "$KEY" ]; then
        KEY="$(python3 - "$MCP_NAME" <<'PYEOF' 2>/dev/null || true
import json, os, re, sys
name = sys.argv[1]
try:
    data = json.load(open(os.path.expanduser("~/.claude.json")))
except Exception:
    raise SystemExit
for scope in [data, *(data.get("projects") or {}).values()]:
    entry = (scope.get("mcpServers") or {}).get(name)
    if not entry:
        continue
    for arg in entry.get("args") or []:
        hit = re.fullmatch(r"--figma-api-key=(.+)", arg)
        if hit:
            print(hit.group(1)); raise SystemExit
    for key in ("FIGMA_API_KEY", "FIGMA_ACCESS_TOKEN"):
        if (entry.get("env") or {}).get(key):
            print(entry["env"][key]); raise SystemExit
PYEOF
)"
        if [ -n "$KEY" ]; then
            security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w "$KEY" -U 2>/dev/null \
                && ok "adopted the key from an existing $MCP_NAME entry, saved to the keychain" \
                || warn "adopted the key from an existing entry — could not write the keychain"
        fi
    fi

    # Only ask where someone can answer. Without a terminal (CI, a scripted run, a pipe) the
    # prompt is a key request printed into a log that nobody reads.
    if [ -z "$KEY" ] && [ -t 0 ]; then
        printf "  ${BOLD}Figma API key${NC} ${DIM}(figd_… — Figma › Settings › Security › Personal access tokens)${NC}\n"
        printf "  ${DIM}Stored in the login keychain, not in this repo. Empty input skips this step.${NC}\n"
        printf "  key: "
        read -rs KEY
        printf "\n"
        if [ -n "$KEY" ]; then
            security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w "$KEY" -U 2>/dev/null \
                && ok "key saved to the login keychain" \
                || warn "could not write the keychain — registering anyway, the key is not remembered"
        fi
    fi

    if [ -z "$KEY" ] && [ ! -t 0 ]; then
        skip "no Figma API key and no terminal to ask — run this from a shell to register Framelink"
    elif [ -z "$KEY" ]; then
        skip "no Figma API key — run again to register Framelink"
    # --scope user is the point: today the same key sits once per project in ~/.claude.json.
    elif claude mcp add --scope user "$MCP_NAME" -- \
            npx -y figma-developer-mcp "--figma-api-key=$KEY" --stdio >/dev/null 2>&1; then
        ok "$MCP_NAME registered for every project (user scope)"
        # Say what the storage actually is. Claude Code writes MCP arguments in the clear, so the
        # keychain is the source and ~/.claude.json is a copy — assuming otherwise is the risk.
        printf "     ${DIM}Claude Code stores MCP arguments in plain text in ~/.claude.json.${NC}\n"
    else
        warn "claude mcp add failed — run it by hand: claude mcp add --scope user $MCP_NAME -- npx -y figma-developer-mcp --figma-api-key=… --stdio"
    fi
fi

# Per-project copies predate the user-scope entry. Named, never deleted: that is someone else's
# configuration, and a duplicate is untidy rather than broken.
PROJECT_COPIES=$(python3 - "$MCP_NAME" <<'PYEOF' 2>/dev/null || echo 0
import json, os, sys
name = sys.argv[1]
try:
    data = json.load(open(os.path.expanduser("~/.claude.json")))
except Exception:
    print(0); raise SystemExit
print(sum(1 for v in (data.get("projects") or {}).values() if name in (v.get("mcpServers") or {})))
PYEOF
)
if [ "${PROJECT_COPIES:-0}" -gt 0 ]; then
    warn "$PROJECT_COPIES project(s) still carry their own $MCP_NAME entry with the key inline"
    printf "     ${DIM}the user-scope entry covers them; remove them with /mcp in that project${NC}\n"
fi

# --- 7. The rule, so a session knows which of the two tools answers which question -------------

if [ -f "$CLAUDE_MD" ] && grep -qF "$TOOLS_MARKER" "$CLAUDE_MD"; then
    skip "~/.claude/CLAUDE.md already carries the tool-choice rule"
else
    [ -f "$CLAUDE_MD" ] && cp "$CLAUDE_MD" "$CLAUDE_MD.bak"
    cat >> "$CLAUDE_MD" <<EOF

$TOOLS_MARKER

Fremdes Layout lesen — Struktur, Text, Textstile beim Namen, Instanzen: Framelink, ein Aufruf.
Alles Schreibende: figma-cli. Auch lesend figma-cli, wo die Antwort vollstaendig oder wahr sein
muss — Variablen und Bindungen (Framelink loest zu Hex auf, Dark Mode wird unsichtbar), versteckte
Knoten (fallen ersatzlos weg) und Vektoren (kommen leer, und die gemeldete ID ist die des
Wrappers). Belege: \`figma-cli docs framelink\`.
EOF
    ok "tool-choice rule appended to ~/.claude/CLAUDE.md"
    [ -f "$CLAUDE_MD.bak" ] && printf "     ${DIM}backup: %s${NC}\n" "$CLAUDE_MD.bak"
fi

LINES=$(wc -l < "$CLAUDE_MD" | tr -d ' ')
if [ "$LINES" -gt 200 ]; then
    warn "~/.claude/CLAUDE.md is now $LINES lines — over the 200-line rule, condense it"
else
    printf "     ${DIM}%s lines of 200${NC}\n" "$LINES"
fi

printf "\n  ${DIM}Running this again changes nothing.${NC}\n\n"
