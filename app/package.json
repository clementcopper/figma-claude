{
  "name": "figmaclaude",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code in a window next to Figma \u2014 a port of clementcopper/claude-terminal-panel",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && node run-electron.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test tests/*.test.js",
    "dist": "npm run build && electron-builder --mac --dir",
    "dist:dmg": "npm run build && electron-builder --mac",
    "install:app": "npm run dist && rm -rf /Applications/FigmaClaude.app && ditto release/mac/FigmaClaude.app /Applications/FigmaClaude.app"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/node": "^22.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0",
    "electron-builder": "^25.1.8"
  },
  "productName": "FigmaClaude",
  "build": {
    "appId": "de.designdone.figmaclaude",
    "productName": "FigmaClaude",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "media/**",
      "resources/**",
      "index.html",
      "preload.cjs",
      "package.json",
      "!media/*.map",
      "!dist/*.map"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "npmRebuild": false
  }
}
